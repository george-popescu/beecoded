{
  "name": "@beecoded/agent-plugins",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@beecoded/agent-plugins",
      "version": "0.1.0",
      "workspaces": [
        "plugins/bee",
        "plugins/nectar"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@beecoded/bee": {
      "resolved": "plugins/bee",
      "link": true
    },
    "node_modules/@beecoded/nectar": {
      "resolved": "plugins/nectar",
      "link": true
    },
    "plugins/bee": {
      "name": "@beecoded/bee",
      "version": "5.0.0",
      "license": "MIT",
      "bin": {
        "bee": "bin/install.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "plugins/nectar": {
      "name": "@beecoded/nectar",
      "version": "2.2.0",
      "license": "MIT",
      "bin": {
        "nectar": "bin/install.mjs"
      },
      "engines": {
        "node": ">=18"
      }
    }
  }
}
