{
  "name": "@beecoded/nectar",
  "version": "3.5.0",
  "description": "Adaptive software delivery, security review and product polish for Claude Code and Codex",
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "spec-driven-development",
    "code-review",
    "mcp",
    "code-index",
    "local-first"
  ],
  "author": {
    "name": "Beecoded",
    "email": "george.popescu@beecoded.ro",
    "url": "https://github.com/beecoded"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beecoded/bee-gpt.git",
    "directory": "plugins/nectar"
  },
  "homepage": "https://github.com/beecoded/bee-gpt/tree/main/plugins/nectar",
  "bugs": {
    "url": "https://github.com/beecoded/bee-gpt/issues"
  },
  "bin": {
    "nectar": "bin/install.mjs"
  },
  "files": [
    ".mcp.json",
    ".mcp.claude.json",
    ".claude-plugin/",
    ".codex-plugin/",
    "agents/",
    "bin/",
    "evals/",
    "mcp/",
    "scripts/",
    "internal-skills/",
    "references/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/check-consistency.js && node --test bin/*.test.mjs mcp/*.test.mjs scripts/*.test.mjs scripts/atlas/*.test.mjs scripts/evals/*.test.mjs scripts/doctor/*.test.mjs",
    "doctor": "node scripts/run-doctor.mjs",
    "evals": "node scripts/run-behavioral-evals.mjs",
    "evals:atlas": "node scripts/run-atlas-evals.mjs",
    "validate": "node ../../tools/validate-package.mjs nectar",
    "prepack": "npm test && npm run validate"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "php-parser": "^3.7.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
